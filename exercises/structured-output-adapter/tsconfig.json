{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": [
      "../../apps/api/node_modules/@types",
      "../../apps/web/node_modules/@types",
      "./node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
