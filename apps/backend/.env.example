NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/enterprise_admin?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-48-byte-random-hex-secret
JWT_REFRESH_SECRET=replace-with-different-48-byte-random-hex-secret
FRONTEND_URL=http://localhost:5173
CSRF_SECRET=

# Required when running `npm run seed:backend` (never commit real passwords)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
