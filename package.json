{
  "name": "enterprise-admin-dashboard",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix apps/frontend",
    "install:backend": "npm install --prefix apps/backend",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "build:frontend": "npm --prefix apps/frontend run build",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "test:backend": "npm --prefix apps/backend run test",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:e2e": "npm --prefix apps/frontend run test:e2e",
    "compile:backend": "npm --prefix apps/backend run compile",
    "typecheck:backend": "npm --prefix apps/backend run typecheck"
  }
}
