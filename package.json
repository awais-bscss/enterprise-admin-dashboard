{
  "name": "enterprise-admin-dashboard",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "install:web": "npm install --prefix apps/web",
    "install:api": "npm install --prefix apps/api",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint",
    "test:web": "npm --prefix apps/web run test",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "test:exercise": "npm --prefix exercises/structured-output-adapter test",
    "compile:api": "npm --prefix apps/api run compile",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "seed:api": "npm --prefix apps/api run seed"
  }
}
